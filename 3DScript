local function rayPt(pos, d)
	local c = workspace.CurrentCamera; if not c then return Part.Position end
	local r = c:ViewportPointToRay(pos.X, pos.Y); return r.Origin + r.Direction * d
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { Part }

track(UIS.InputBegan:Connect(function(inp, gp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		local c = workspace.CurrentCamera
		if dragOn and c and hubOpen and Gui.Enabled and Part.Parent then
			local r = c:ViewportPointToRay(inp.Position.X, inp.Position.Y)
			local hit = workspace:Raycast(r.Origin, r.Direction * 120, rayParams)
			if hit and hit.Instance == Part then
				isDrag, followCam = true, false; refreshUI()
				dragDist = math.clamp((hit.Position - c.CFrame.Position).Magnitude, 4, 24)
				dragOff = Part.Position - hit.Position; statusLbl.Text = tr("drg"); return
			end
		end
	elseif not gp and inp.KeyCode == Enum.KeyCode.K then
		hubOpen = not hubOpen; Gui.Enabled = hubOpen; if hubOpen then restore() end
	end
end))

track(UIS.InputChanged:Connect(function(inp)
	if isDrag and dragOn and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
		local c = workspace.CurrentCamera; if not c then return end
		local cf = CFrame.lookAt(rayPt(inp.Position, dragDist) + dragOff, c.CFrame.Position, c.CFrame.UpVector) * CFrame.Angles(0, 0, tiltZ())
		pinnedCF, curCF, Part.CFrame = cf, cf, cf
	end
end))

track(UIS.InputEnded:Connect(function(inp)
	if isDrag and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
		isDrag = false; if pinnedCF then curCF = pinnedCF end; statusLbl.Text = tr("pnd")
	end
end))

