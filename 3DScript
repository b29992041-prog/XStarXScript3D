local function runUrl(name, url)
	statusLbl.Text = tr("ld", name)
	task.spawn(function()
		local ok, src = pcall(function() return game:HttpGet(url) end)
		if not ok or type(src) ~= "string" or #src == 0 then statusLbl.Text = tr("err", name); return end
		local fn, lErr = loadstring(src)
		if type(fn) ~= "function" then statusLbl.Text = tr("err", tostring(lErr)); return end
		local rOk, rErr = pcall(fn)
		statusLbl.Text = rOk and tr("ok", name) or tr("err", tostring(rErr))
		task.delay(.5, function() if hubOpen then restore() end end)
	end)
end

local function sendFeedback()
	local msg = fbBox and string.gsub(fbBox.Text, "^%s*(.-)%s*$", "%1") or ""
	if #msg == 0 then statusLbl.Text = tr("fbEmpty"); return end
	local now = os.clock()
	if now - lastSend < COOLDOWN_SEC then statusLbl.Text = tr("fbWait", math.ceil(COOLDOWN_SEC - (now - lastSend))); return end
	if not WEBHOOK_URL:match("^https://discord%.com/api/webhooks/") then statusLbl.Text = tr("fbNoUrl"); return end
	local reqFn = (type(request) == "function" and request) or (type(http_request) == "function" and http_request) or (syn and type(syn.request) == "function" and syn.request)
	if not reqFn then statusLbl.Text = tr("fbNoReq"); return end
	lastSend = now
	task.spawn(function()
		local body = HttpService:JSONEncode({
			username = "XStarX 3D v0.98",
			content = string.format("**User:** %s (`%d`) | **PlaceId:** `%d`\n**Feedback:** %s", LP.Name, LP.UserId, game.PlaceId, string.sub(msg, 1, 1500))
		})
		local ok, res = pcall(reqFn, { Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
		if ok and res and (res.StatusCode == 200 or res.StatusCode == 204 or not res.StatusCode) then
			if fbBox then fbBox.Text = "" end
			statusLbl.Text = tr("fbSent")
		else
			statusLbl.Text = tr("fbFail")
		end
	end)
end

