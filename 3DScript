local rayParams = RaycastParams.new()
rayParams.FilterType, rayParams.FilterDescendantsInstances = Enum.RaycastFilterType.Include, { Part }

UIS.InputBegan:Connect(function(inp, gp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		local c = workspace.CurrentCamera
		if dragOn and c and hubOpen and Gui.Enabled and Part.Parent then
			local r = c:ViewportPointToRay(inp.Position.X, inp.Position.Y)
			local hit = workspace:Raycast(r.Origin, r.Direction * 120, rayParams)
			if hit and hit.Instance == Part then
				isDrag, followCam = true, false; refreshUI()
				dragDist = math.clamp((hit.Position - c.CFrame.Position).Magnitude, 4, 24)
				dragOff = Part.Position - hit.Position; statusLbl.Text = tr("drg"); return
			end
		end
	elseif not gp and inp.KeyCode == Enum.KeyCode.K then
		hubOpen = not hubOpen; Gui.Enabled = hubOpen; if hubOpen then restore() end
	end
end)

UIS.InputChanged:Connect(function(inp)
	if joyActive and inp == joyTouch then updateJoy(inp.Position) end
	if fcJoyAct and inp == fcJoyTouch then updFcJoy(inp.Position) end
	if isDrag and dragOn and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
		local c = workspace.CurrentCamera; if not c then return end
		local r = c:ViewportPointToRay(inp.Position.X, inp.Position.Y)
		local cf = CFrame.lookAt(r.Origin + r.Direction * dragDist + dragOff, c.CFrame.Position, c.CFrame.UpVector) * CFrame.Angles(0, 0, tiltZ())
		pinnedCF, curCF, Part.CFrame = cf, cf, cf
	end
end)

UIS.InputEnded:Connect(function(inp)
	if joyActive and inp == joyTouch then resetJoy(); statusLbl.Text = tr("pnd") end
	if fcJoyAct and inp == fcJoyTouch then
		fcJoyAct, fcJoyTouch, fcLvl, fcDir = false, nil, 0, Vector3.zero
		if fcInner then fcInner.Position = UDim2.new(0.5, -fcInner.AbsoluteSize.X/2, 0.5, -fcInner.AbsoluteSize.Y/2) end
	end
	if isDrag and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
		isDrag = false; if pinnedCF then curCF = pinnedCF end; statusLbl.Text = tr("pnd")
	end
end)

refreshUI(); PinBtn.Text = followCam and tr("pin") or tr("pinned"); statusLbl.Text = tr("rdy")

RunService.RenderStepped:Connect(function(dt)
	local c = workspace.CurrentCamera
	if not c then return end

	if Folder.Parent and Part.Parent and not isDrag then
		if joyActive and joyVec.Magnitude > 0.02 then
			local move = (c.CFrame.RightVector * joyVec.X - c.CFrame.UpVector * joyVec.Y) * (dt * 7)
			pinnedCF = (pinnedCF or Part.CFrame) + move
			curCF = curCF:Lerp(pinnedCF, math.clamp(dt * 14, 0, 1))
			Part.CFrame = curCF
		else
			curCF = curCF:Lerp(followCam and targetCF() or (pinnedCF or curCF), math.clamp(dt * 9, 0, 1))
			Part.CFrame = curCF
		end
	end

	if fcActive and fcEnabled and fcPart and fcGui and fcGui.Enabled then
		if fcLvl > 1 then
			local moveSpd = (fcLvl * 0.02) * fcSpeed
			local moveDir = (c.CFrame.LookVector * -fcDir.Z) + (c.CFrame.RightVector * fcDir.X) + Vector3.new(0, fcDir.Y, 0)
			if moveDir.Magnitude > 0 then fcPos += moveDir.Unit * moveSpd * dt * 60 end
		end
		local lk = c.CFrame.LookVector
		fcPart.CFrame = CFrame.new(fcPos) * CFrame.Angles(0, math.atan2(lk.X, lk.Z), 0)
	end
end)
