local function targetCF()
	local c = workspace.CurrentCamera and workspace.CurrentCamera.CFrame
	if not c then return Part.CFrame end
	return CFrame.lookAt(c.Position + c.LookVector * dist + Vector3.new(0, .15, 0), c.Position, c.UpVector) * CFrame.Angles(0, 0, tiltZ())
end
