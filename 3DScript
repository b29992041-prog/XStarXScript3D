local function switchTab(idx, instant)
	pcall(function()
		if idx == curTab and not instant then return end
		local dir = (idx >= curTab) and 1 or -1
		curTab = idx
		for i, sb in ipairs(segBtns) do sb.b.TextColor3 = (i == idx) and Color3.new(1,1,1) or pal().m end
		if syncPill then syncPill(instant) end
		for i, pg in ipairs(pages) do
			if i == idx then
				pg.Visible = true
				if instant then pg.Position = UDim2.fromScale(0, 0)
				else
					pg.Position = UDim2.fromScale(dir * .22, 0)
					TweenService:Create(pg, TweenInfo.new(.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0, 0) }):Play()
				end
			elseif pg.Visible then
				local old = pg
				if instant then old.Visible = false; old.Position = UDim2.fromScale(0, 0)
				else
					local tw = TweenService:Create(old, TweenInfo.new(.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(-dir * .22, 0) })
					tw:Play()
					tw.Completed:Once(function() if curTab ~= i then old.Visible = false; old.Position = UDim2.fromScale(0, 0) end end)
				end
			end
		end
	end)
end

