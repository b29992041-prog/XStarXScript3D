local function setFreecamState(state)
	fcEnabled = state
	local c = workspace.CurrentCamera
	if fcEnabled and fcPart then
		fcPos = c.CFrame.Position
		fcPart.CFrame = c.CFrame
		c.CameraSubject = fcPart
		c.CameraType = Enum.CameraType.Custom
		LP.CameraMinZoomDistance, LP.CameraMaxZoomDistance = 0, 0
		if fcToggleBtn then fcToggleBtn.Text, fcToggleBtn.BackgroundColor3 = "FREECAM: ON", Color3.fromRGB(0,136,255) end
		if fcJoyWrap then fcJoyWrap.Visible = true end
	else
		c.CameraSubject = LP.Character and LP.Character:FindFirstChild("Humanoid") or nil
		LP.CameraMinZoomDistance, LP.CameraMaxZoomDistance = origMinZ, origMaxZ
		if fcToggleBtn then fcToggleBtn.Text, fcToggleBtn.BackgroundColor3 = "FREECAM: OFF", Color3.fromRGB(60,60,70) end
		if fcJoyWrap then fcJoyWrap.Visible = false end
	end
end

local function updFcJoy(pos)
	if not fcOuter or not fcInner then return end
	local ctr = fcOuter.AbsolutePosition + fcOuter.AbsoluteSize * 0.5
	local rad = fcOuter.AbsoluteSize.X * 0.5
	local d = pos - ctr
	local mag = math.min(d.Magnitude, rad)
	local off = d.Magnitude > 0 and d.Unit * mag or Vector2.zero
	local inW = fcInner.AbsoluteSize.X
	fcInner.Position = UDim2.new(0.5, off.X - inW/2, 0.5, off.Y - inW/2)
	fcLvl = math.floor((mag / rad) * 100)
	fcDir = Vector3.new(off.X / rad, 0, off.Y / rad)
end

