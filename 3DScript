local function updateJoy(pos)
	local center = outer.AbsolutePosition + outer.AbsoluteSize * 0.5
	local maxR = (sizeOuter - sizeInner) * 0.5
	local delta = pos - center
	local clamped = delta.Magnitude > maxR and (delta.Unit * maxR) or delta
	inner.Position = UDim2.new(0.5, clamped.X - sizeInner/2, 0.5, clamped.Y - sizeInner/2)
	joyVec = maxR > 0 and (clamped / maxR) or Vector2.zero
end

local function resetJoy()
	joyActive, joyTouch, joyVec = false, nil, Vector2.zero
	inner.Position = UDim2.new(0.5, -sizeInner/2, 0.5, -sizeInner/2)
	if pinnedCF then curCF = pinnedCF end
end

