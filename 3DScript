local function restore()
	pcall(function()
		if not Folder.Parent then Folder = Instance.new("Folder"); Folder.Name = TAG; Folder.Parent = workspace end
		if not Part.Parent then Part.Parent = Folder end
		if not Gui.Parent then Gui.Parent = PGui end
		Gui.Adornee, Gui.Enabled, hubOpen, followCam, isDrag = Part, true, true, true, false
		curCF = targetCF(); Part.CFrame = curCF
		refreshUI(); statusLbl.Text = tr("rst")
	end)
end

local function runUrl(name, url)
	statusLbl.Text = tr("ld", name)
	task.spawn(function()
		local ok, src = pcall(function() return game:HttpGet(url) end)
		if not ok or type(src) ~= "string" or #src == 0 then statusLbl.Text = tr("err", name); return end
		local fn, lErr = loadstring(src)
		if type(fn) ~= "function" then statusLbl.Text = tr("err", tostring(lErr)); return end
		local rOk, rErr = pcall(fn)
		statusLbl.Text = rOk and tr("ok", name) or tr("err", tostring(rErr))
		task.delay(.5, function() if hubOpen then restore() end end)
	end)
end

local function applyMove()
	pcall(function()
		local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = Moves[moveIdx].w; hum.UseJumpPower = true; hum.JumpPower = Moves[moveIdx].j end
	end)
end

local function applyFps()
	pcall(function()
		if not fpsOn then return end
		Lighting.GlobalShadows = false
		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CastShadow = false
				if v.Material == Enum.Material.Glass or v.Material == Enum.Material.Neon then v.Material = Enum.Material.SmoothPlastic end
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
				v.Enabled = false
			end
		end
	end)
end

