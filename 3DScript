local function runUrl(name, url)
	statusLbl.Text = tr("ld", name)
	task.spawn(function()
		local ok, src = pcall(function() return game:HttpGet(url) end)
		if not ok or type(src) ~= "string" or #src == 0 then statusLbl.Text = tr("err", name); return end
		local fn, lErr = loadstring(src)
		if type(fn) ~= "function" then statusLbl.Text = tr("err", tostring(lErr)); return end
		local rOk, rErr = pcall(fn)
		statusLbl.Text = rOk and tr("ok", name) or tr("err", tostring(rErr))
		task.delay(.5, function() if hubOpen then restore() end end)
	end)
end

