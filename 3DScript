local function mk(cls, props, par)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do o[k] = v end
	if par then o.Parent = par end
	return o
end
local function cr(o, r) return mk("UICorner", { CornerRadius = UDim.new(0, r or 12) }, o) end
local function sk(o, th, trp, col) return mk("UIStroke", { Thickness = th or 1.2, Transparency = trp or .3, Color = col or Color3.new(1,1,1) }, o) end
local function ll(o, pad, dir) return mk("UIListLayout", { Padding = UDim.new(0, pad or 8), FillDirection = dir or Enum.FillDirection.Vertical }, o) end
local function pd(o, l, r, t, b) return mk("UIPadding", { PaddingLeft = UDim.new(0,l or 0), PaddingRight = UDim.new(0,r or l or 0), PaddingTop = UDim.new(0,t or 0), PaddingBottom = UDim.new(0,b or t or 0) }, o) end

